# Server-side, set these in the Vercel project settings (never prefix them with VITE_).
RESEND_API_KEY=
# Optional overrides. CONTACT_TO_EMAIL takes a comma-separated list; the defaults are in api/contact.js.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: send the form somewhere other than /api/contact. Production builds use
# /api/contact by default. Under `npm run dev` the form opens the visitor's email app,
# because Vite does not serve the api/ folder.
VITE_CONTACT_ENDPOINT=
